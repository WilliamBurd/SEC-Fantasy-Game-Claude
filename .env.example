# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API Keys). Never commit .env.local.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_). Server only: it bypasses Row Level Security.
SUPABASE_SECRET_KEY=
