# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API Keys). Never commit .env.local.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_). Server only: it bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# CollegeFootballData API key (free at collegefootballdata.com). Server only.
CFBD_API_KEY=

# Shared secret for the data pipeline routes (/api/jobs/*). Any long random
# string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
